{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imogen:eob:dental:1.2",
  "schema_id": "b19e718f45d24b98a1da832e4d2a89f5",
  "title": "DentalEOBSchema",
  "description": "Structured representation of Explanation of Benefits for dental claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["patient", "provider", "claim", "services", "totals"],
  "properties": {
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patient_name", "subscriber_id"],
      "properties": {
        "patient_name": { "type": "string", "minLength": 1 },
        "patient_id":    { "type": "string" },
        "date_of_birth": { "type": "string", "format": "date" },
        "subscriber_id": { "type": "string", "minLength": 1 },
        "group_number":  { "type": "string" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_name"],
      "properties": {
        "provider_name": { "type": "string", "minLength": 1 },
        "npi":   { "type": "string", "pattern": "^\\d{10}$" },
        "tax_id":{ "type": "string", "pattern": "^(?:\\d{2}-?\\d{7}|\\d{9})$" },
        "location": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_number", "status"],
      "properties": {
        "claim_number": { "type": "string", "minLength": 1, "maxLength": 64 },
        "claim_received_date":  { "type": "string", "format": "date" },
        "claim_processed_date": { "type": "string", "format": "date" },
        "payer_name": { "type": "string", "minLength": 1 },
        "plan_type":  { "type": "string" },
        "status":     { "type": "string", "enum": ["Paid","Denied","Partially Paid","Pending"] }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["procedure_code", "charged_amount"],
        "properties": {
          "service_date": { "type": "string", "format": "date" },
          "procedure_code": { "type": "string", "pattern": "^D\\d{4}[A-Z]?$" },
          "tooth_number": { "type": "string", "pattern": "^(?:[1-9]|[1-2][0-9]|3[0-2]|[A-T])$" },
          "tooth_surface": { "type": "string", "pattern": "^[A-Z]{1,5}$" },
          "charged_amount":            { "$ref": "#/$defs/Amount" },
          "allowed_amount":            { "$ref": "#/$defs/Amount" },
          "insurance_paid":            { "$ref": "#/$defs/Amount" },
          "patient_responsibility":    { "$ref": "#/$defs/Amount" },
          "remark_code":        { "type": "string", "pattern": "^[A-Z0-9\\-]{1,6}$" },
          "remark_description": { "type": "string" }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_charged", "total_paid"],
      "properties": {
        "total_charged":               { "$ref": "#/$defs/Amount" },
        "total_allowed":               { "$ref": "#/$defs/Amount" },
        "total_paid":                  { "$ref": "#/$defs/Amount" },
        "total_patient_responsibility":{ "$ref": "#/$defs/Amount" },
        "deductible":                  { "$ref": "#/$defs/Amount" },
        "copay":                       { "$ref": "#/$defs/Amount" },
        "currency": { "type": "string", "default": "USD", "pattern": "^[A-Z]{3}$" }
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "description"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9]{1,5}$" },
          "description": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id":         { "type": "string" },
        "received_timestamp":  { "type": "string", "format": "date-time" },
        "processed_timestamp": { "type": "string", "format": "date-time" },
        "schema_ref":          { "type": "string", "const": "urn:imogen:eob:dental:1.2" },
        "source_node":         { "type": "string", "enum": ["Redis","n8n","Unstract","NativeOCR","Other"] },
        "canonical_sha256":    { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "canonical_sha256_scope": { "type": "string" }
      }
    },
    "provenance": {
      "description": "Optional evidence map for auditability without polluting scalar fields.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ptr", "source", "confidence"],
        "properties": {
          "ptr": { "type": "string" },
          "source": { "type": "string", "enum": ["vision", "vlm", "manual", "derived"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "page_index": { "type": "integer", "minimum": 0 },
          "box_px": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "w": { "type": "integer", "minimum": 1 },
              "h": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Amount": {
      "description": "Currency amount in major units, 2-decimal fixed. Use string for deterministic validation.",
      "oneOf": [
        { "type": "string", "pattern": "^-?\\d{1,9}(\\.\\d{2})?$" },
        { "type": "number", "minimum": -1000000000, "maximum": 1000000000, "multipleOf": 0.01 }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "claim": { "properties": { "status": { "const": "Denied" } }, "required": ["status"] } } },
      "then": { "properties": { "totals": { "properties": { "total_paid": { "const": "0.00" } } } } }
    }
  ]
}
